# --- Vercel frontend ---
# QR links. Same-origin /api does not need VITE_API_URL.
VITE_APP_URL="https://YOUR-APP.vercel.app"

# --- Server (Vercel functions + local npm run dev). Never use VITE_ for these. ---
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-never-in-the-browser"
DESK_OPERATORS="you@email"
FRONTEND_URL="https://YOUR-APP.vercel.app"
CORS_ORIGIN="https://YOUR-APP.vercel.app,http://localhost:3000"

# Optional machine key for seed scripts only (not the browser).
# API_KEY="change-me"
