# --- Vercel frontend ---
# Railway API origin (no trailing slash)
VITE_API_URL="https://YOUR-API.up.railway.app"

# Canonical public site used inside QR codes (your Vercel URL)
VITE_APP_URL="https://YOUR-APP.vercel.app"

# Optional office lock. Must match Railway API_KEY if that is set.
# VITE_API_KEY="change-me"

# --- Railway backend ---
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
FRONTEND_URL="https://YOUR-APP.vercel.app"
CORS_ORIGIN="https://YOUR-APP.vercel.app,http://localhost:3000"

# Optional office lock
# API_KEY="change-me"
