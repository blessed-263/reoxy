# --- Vercel frontend ---
# Railway API origin (used by build health check / QR if needed)
VITE_API_URL="https://YOUR-API.up.railway.app"
VITE_APP_URL="https://YOUR-APP.vercel.app"

# --- Railway backend ---
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
FRONTEND_URL="https://YOUR-APP.vercel.app"
CORS_ORIGIN="https://YOUR-APP.vercel.app,http://localhost:3000"

# Single operator account (required). Never put these on Vercel as VITE_*.
AUTH_USER="operator"
AUTH_PASSWORD="choose-a-long-passphrase"
AUTH_SECRET="random-32-plus-character-string"

# Optional machine key for seed scripts only (not the browser).
# API_KEY="change-me"
